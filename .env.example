# Windows 计划任务会读取项目目录的 .env。手动启动时可使用系统环境变量，
# 也可以显式运行 node --env-file-if-exists=.env server/index.js。
#
# 对外运营时配置正式证书、持久化数据目录和 SMTP，再启用生产模式。
#NODE_ENV=production
#HOST=127.0.0.1
#PORT=9000
#DATA_DIR=D:/FishGame/data
#TLS_CERT=D:/FishGame/certs/fullchain.pem
#TLS_KEY=D:/FishGame/certs/privkey.pem
#TRUST_PROXY_HOPS=0

# --- 方案 A：本地调试，邮件只进 Mailpit（不真的发出去）---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@fishmarket.local

# --- 方案 B：QQ 邮箱真实投递 ---
# 授权码在 QQ 邮箱 → 设置 → 账户 → POP3/IMAP/SMTP服务 → 开启并生成授权码
# SMTP_PASS 必须填授权码，不是 QQ 登录密码。
#SMTP_HOST=smtp.qq.com
#SMTP_PORT=465
#SMTP_USER=你的QQ号@qq.com
#SMTP_PASS=授权码
#SMTP_FROM=你的QQ号@qq.com

# --- 方案 C：其它服务商 ---
# 163 邮箱同样用授权码，465 隐式 TLS：
#SMTP_HOST=smtp.163.com
#SMTP_PORT=465
#SMTP_USER=你的邮箱@163.com
#SMTP_PASS=授权码
#
# Gmail 用「应用专用密码」，587 走 STARTTLS：
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=starttls

# 可选：SMTP_HELO 指定 EHLO 域名；SMTP_TLS_INSECURE=1 跳过证书校验（仅测试）
